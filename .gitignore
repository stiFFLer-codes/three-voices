# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# Data cache (regenerate with: python -m src.data)
data/raw/*.csv

# Models (regenerable) — comment out if you want to track them
models/*.pkl
models/*.joblib

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.ipynb_checkpoints/
.vscode/
.idea/
*.swp
*~

# Internal working notes (decision log, revision briefs, audits, assistant
# configuration), kept locally and not tracked. Moved out of tracking on
# 2026-10-12; earlier versions remain in git history.
notes/
CLAUDE.md
.claude/

# Summer-school binaries (kept locally, not tracked). Do NOT add *.pdf —
# a future manuscript PDF must stay trackable.
*.pptx
COG1_Submission_Maitreya.pdf

# Scaffold / packaging archives, including the arXiv upload tarball.
*.zip
*.tar.gz

# LaTeX build artifacts (main.pdf and main.bbl stay tracked: the bbl is what
# arXiv wants, and the PDF is the reviewable deliverable)
paper/*.aux
paper/*.log
paper/*.out
paper/*.blg
paper/*.synctex.gz
paper/pass*.txt
paper/bibtex.txt

# arXiv upload staging dir, rebuilt by the ARXIV_SUBMISSION.md packaging block
arxiv/
